rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.token.email == "mh.makrostore@gmail.com"; }
    function isOrderPick() { return signedIn() && request.auth.token.email == "orderpick@maxi.bonaire"; }
    function isTablet() { return signedIn() && exists(/databases/$(database)/documents/tabletUsers/$(request.auth.token.email)) && get(/databases/$(database)/documents/tabletUsers/$(request.auth.token.email)).data.active != false; }
    match /catalogProducts/{productId} { allow read: if isOwner() || isTablet(); allow create, update, delete: if isOwner(); }
    match /sales/{saleId} {
      allow read: if isOwner() || isOrderPick() || isTablet();
      allow create: if isOwner() || (isTablet() && request.resource.data.createdByEmail == request.auth.token.email);
      allow update: if isOwner() || isOrderPick();
      allow delete: if isOwner();
    }
    match /customers/{customerId} { allow read: if isOwner() || isTablet(); allow create, update, delete: if isOwner(); }
    match /publicSettings/{docId} { allow read, create, update, delete: if isOwner(); }
    match /tabletUsers/{email} { allow read: if isOwner() || (signedIn() && request.auth.token.email == email); allow create, update, delete: if isOwner(); }
    match /users/{userId} { allow read, create, update, delete: if isOwner(); }
  }
}
